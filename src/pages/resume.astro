---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resume">
  <main class="min-h-dvh flex items-center justify-center px-6 py-24">
    <div
      class="max-w-md w-full rounded-2xl border border-border bg-card shadow-sm p-8 text-center space-y-3"
    >
      <h1 class="text-2xl font-semibold tracking-tight">Resume</h1>
      <p class="text-muted-foreground">
        Work in progress — check back soon.
      </p>
      <p class="text-sm text-muted-foreground">
        In the meantime, head back <a class="underline" href="/">home</a>.
      </p>
    </div>
  </main>
</Layout>
