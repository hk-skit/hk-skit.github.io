---
export const prerender = true;
import ResumeLayout from "@/layouts/ResumeLayout.astro";
import { DATA } from "@/data/resume";

const stripUrl = (u: string) =>
  u.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");

const social = DATA.contact.social;
const presentLabel = DATA.sections.work.presentLabel;

// Social links shown in the sidebar as icon + full, resolvable handle.
const socialLinks = [social.GitHub, social.LinkedIn, social.StackOverflow];
---

<ResumeLayout>
  <div class="resume-page">
    <div class="resume-toolbar no-print">
      <a href="/" class="resume-back">← hiteshkumar.dev</a>
      <button type="button" class="resume-print" onclick="window.print()">
        Print / Download PDF
      </button>
    </div>

    <main class="resume">
      <aside class="resume-sidebar">
        <img
          class="resume-avatar"
          src={DATA.avatarUrl}
          alt={DATA.name}
          width="128"
          height="128"
        />
        <h1 class="resume-name">{DATA.name}</h1>
        <p class="resume-title">{DATA.resume.headline}</p>

        <dl class="resume-contact">
          <div class="resume-contact-row print-only">
            <dt>Telephone</dt>
            <dd>{DATA.contact.tel}</dd>
          </div>
          <div class="resume-contact-row">
            <dt>Email</dt>
            <dd><a href={`mailto:${DATA.contact.email}`}>{DATA.contact.email}</a></dd>
          </div>
          <div class="resume-contact-row">
            <dt>Website</dt>
            <dd><a href={DATA.url}>{stripUrl(DATA.url)}</a></dd>
          </div>
          <div class="resume-contact-row">
            <dt>Address</dt>
            <dd>{DATA.location}</dd>
          </div>
        </dl>

        <section class="resume-sec">
          <h2>Proficiencies</h2>
          <p class="resume-prof">{DATA.skills.join(", ")}</p>
        </section>

        <section class="resume-sec">
          <h2>Education</h2>
          {DATA.education.map((e) => (
            <div class="resume-edu">
              <p class="resume-edu-degree">{e.degree} {e.field}</p>
              <p class="resume-edu-school">{e.school}</p>
              <p class="resume-edu-meta">{e.start}&ndash;{e.end} &middot; {e.location}</p>
            </div>
          ))}
        </section>

        <section class="resume-sec">
          <h2>Social</h2>
          <ul class="resume-social">
            {socialLinks.map((s) => {
              const Icon = s.icon;
              return (
                <li>
                  <span class="resume-social-icon"><Icon /></span>
                  <a href={s.url}>{stripUrl(s.url)}</a>
                </li>
              );
            })}
          </ul>
        </section>
      </aside>

      <div class="resume-main">
        <section class="resume-sec">
          <h2>Profile Snapshot</h2>
          <p class="resume-profile">{DATA.resume.summary}</p>
        </section>

        <section class="resume-sec">
          <h2>Experience</h2>
          {DATA.work.map((job) => (
            <article class="resume-role">
              <div class="resume-role-head">
                <h3 class="resume-role-title">{job.title} &middot; {job.company}</h3>
                <span class="resume-role-dates">
                  {job.start} &ndash; {job.end ?? presentLabel}
                </span>
              </div>
              {job.blurb && <p class="resume-role-blurb">{job.blurb}</p>}
              {job.highlights && job.highlights.length > 0 && (
                <ul class="resume-bullets">
                  {job.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
            </article>
          ))}
        </section>
      </div>
    </main>
  </div>
</ResumeLayout>
