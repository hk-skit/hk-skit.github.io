---
import "../styles/global.css";
import "../styles/resume.css";
import { DATA } from "@/data/resume";
import { CONFIG } from "@/data/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Resume",
  description = `Resume of ${DATA.name} — ${DATA.resume.headline}.`,
  image,
  canonicalURL = Astro.url.href,
} = Astro.props;

const pageTitle = CONFIG.seo.titleTemplate
  .replace("%s", title)
  .replace("%n", DATA.name);
const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${CONFIG.site.url}${image}`
  : `${CONFIG.site.url}${DATA.ogImage}`;

const { baseFontSize } = CONFIG.typography;

// Standalone document layout for /resume. Deliberately omits the FlickeringGrid
// header, the navbar dock, and the shared dark-mode FOUC script — the resume
// renders light-only (no `.dark` class is ever applied), matching print.
// Document width lives in resume.css, not here.
---

<html
  lang={CONFIG.site.locale.split("_")[0]}
  style={`font-size: ${baseFontSize}%;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Robots -->
    <meta name="robots" content={CONFIG.seo.robots} />

    <!-- OpenGraph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={DATA.name} />
    <meta property="og:locale" content={CONFIG.site.locale} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content={CONFIG.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <slot />
  </body>
</html>
