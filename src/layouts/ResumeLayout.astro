---
import "../styles/global.css";
import "../styles/resume.css";
import { DATA } from "@/data/resume";
import { CONFIG } from "@/data/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Resume",
  description = `Resume of ${DATA.name} — ${DATA.resume.headline}.`,
  image,
  canonicalURL = Astro.url.href,
} = Astro.props;

const pageTitle = CONFIG.seo.titleTemplate
  .replace("%s", title)
  .replace("%n", DATA.name);
const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${CONFIG.site.url}${image}`
  : `${CONFIG.site.url}${DATA.ogImage}`;

const { baseFontSize } = CONFIG.typography;

// Standalone document layout for /resume. Deliberately omits the FlickeringGrid
// header and the navbar dock. Dark mode is supported (toggled from the resume
// toolbar and shared with the rest of the site via the `theme` localStorage
// key); print always renders light, enforced by a token reset in resume.css.
// Document width lives in resume.css, not here.
---

<html
  lang={CONFIG.site.locale.split("_")[0]}
  style={`font-size: ${baseFontSize}%;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC prevention: apply stored theme before first paint (shared with the
         rest of the site via the `theme` key). Print stays light regardless. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (
            theme === "dark" ||
            (!theme &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (_) {}
      })();
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Robots -->
    <meta name="robots" content={CONFIG.seo.robots} />

    <!-- OpenGraph -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={DATA.name} />
    <meta property="og:locale" content={CONFIG.site.locale} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content={CONFIG.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <slot />
  </body>
</html>
